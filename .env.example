# Long, random value used to HMAC-sign staff sessions (use at least 32 random bytes).
SESSION_SECRET=replace-with-a-long-random-secret

# Password staff use on login.html. Choose a strong, unique value.
SHIFT_NOTES_PASSWORD=replace-with-a-strong-staff-password

# Zoho SMTP server for your account data center; confirm it in Zoho Mail SMTP settings.
ZOHO_SMTP_HOST=smtp.zoho.com

# Zoho SMTP SSL port for your account data center (normally 465).
ZOHO_SMTP_PORT=465

# Full Zoho Mail address used to authenticate and send shift-note email.
ZOHO_SMTP_USER=shift-notes@your-domain.example

# App-specific password generated at https://accounts.zoho.com/home#security/app_password
ZOHO_SMTP_APP_PASSWORD=replace-with-zoho-app-password

# Inbox that receives completed shift notes.
SHIFT_NOTES_EMAIL_TO=shift-notes@example.com
